{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/nr01/avaliacao/[id]/pdf/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/expire-subscriptions",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/nr01-pulses",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/radar-collect",
      "schedule": "30 11 * * *"
    }
  ]
}
